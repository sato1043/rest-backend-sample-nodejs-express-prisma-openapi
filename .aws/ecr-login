#!/bin/sh
[ ! -f .env ] || export $(grep -v '^#' .env | xargs)

[ -z "$AWS_ACCOUNT_ID" ] && exit 1
[ -z "$AWS_REGION" ] && exit 1
[ -z "$AWS_PROFILE" ] && exit 1

alias aws="docker run --rm -it -v $(pwd)/.aws/aws:/aws -v $(pwd)/.aws:/root/.aws -eAWS_PROFILE=${AWS_PROFILE} public.ecr.aws/aws-cli/aws-cli:2.10.3"

aws sts get-caller-identity > /dev/null
if [ $? -ne 0 ]; then
  echo sign in to AWS ... and try again
  aws sso login
  exit 0
fi

ECR_HOST=${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com

echo docker signing in to ECR \("${ECR_HOST}"\)...

aws ecr get-login-password --region "${AWS_REGION}"  \
  | docker login --username AWS --password-stdin "${ECR_HOST}"

aws configure list

echo Please do \`docker logout\` after all work
