#!/bin/sh
[ ! -f .env ] || export $(grep -v '^#' .env | xargs)

[ -z "$AWS_REGION" ] && exit 1
[ -z "$AWS_ACCOUNT_ID" ] && exit 1

ECR_HOST=${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com

REPOS_NAME=node
IMAGE_TAG=16-alpine3.15
#IMAGE_TAG=22-alpine

cat <<EOD
======
** pulling base image **
======
EOD
docker image pull ${REPOS_NAME}:${IMAGE_TAG}
docker image ls --format "table {{.ID}}\t{{.Repository}}\t{{.Tag}}" | grep ${IMAGE_TAG}

cat <<EOD
======
** pushing base image **
======
  ${ECR_HOST}/${REPOS_NAME}:${IMAGE_TAG}
EOD
docker tag "${REPOS_NAME}:${IMAGE_TAG}" "${ECR_HOST}/${REPOS_NAME}":"${IMAGE_TAG}"
docker push "${ECR_HOST}/${REPOS_NAME}":"${IMAGE_TAG}"
