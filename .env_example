
PROJECT=rest-backend-1

#APP1_HOST=127.0.0.1
APP1_HOST=host.docker.internal
APP1_PORT=3000
APP1_API_KEY_PASSPHRASE=99999999-9999-4aaa-aaaa-999999999999
APP1_API_KEY_SALT=99999999-9999-4aaa-aaaa-999999999999
APP1_API_KEY=["99999999-9999-4aaa-aaaa-999999999999"]

#RDB1_HOST=127.0.0.1
RDB1_HOST=host.docker.internal
RDB1_PORT=3306
RDB1_TZ=Asia/Tokyo
RDB1_ROOT_PASS=password
RDB1_USER=backend
RDB1_PASS=password
RDB1_DB_NAME=backend
RDB1_PRISMA_SHADOW_DB_NAME=backend_prisma_shadow_db
#RDB1_PRISMA_SHADOW_DB_URL=mysql://backend:password@127.0.0.1:3306/backend_prisma_shadow_db
RDB1_PRISMA_SHADOW_DB_URL=mysql://backend:password@host.docker.internal:3306/backend_prisma_shadow_db

# below is also used in release build
#RDB1_URL=mysql://backend:password@127.0.0.1:3306/backend
RDB1_URL=mysql://backend:password@host.docker.internal:3306/backend

# belows are also used in release build
HEALTHCHECK_ENDPOINT_PATH=/health
GRACEFUL_SHUTDOWN_TIMEOUT_SEC=10

# belows are also used in release docker push
AWS_REGION=ap-northeast-1
AWS_ACCOUNT_ID=000000000000
AWS_PROFILE=sandboxA
REPOS_NAME=sample-nodejs-express-prisma-openapi

# belows are also used in release docker push
SAAS_DOMAIN=localhost

# debuging
FAKE_SEED=0
FAKE_X_API_KEY=99999999999999999...
PRISMA_QUERY_LOG=false
ERROR_STACK_LEN=4
LISTEN_ON_HTTPS=true
