{
  "name": "rest-be-sample-nodejs-express-prisma-openapi",
  "version": "1.0.0",
  "repository": {
    "type": "git",
    "url": "git@github.com:sato1043/rest-be-sample-nodejs-express-prisma-openapi.git"
  },
  "license": "MIT",
  "private": false,
  "engines": {
    "node": "16.x",
    "yarn": "1.x"
  },
  "scripts": {
    "prerequisites": "scripts/prerequisites.sh && yarn install",
    "postrequisites": "scripts/postrequisites.sh",
    "postinstall": "typesync || :",
    "ecr:login": ".aws/ecr-login",
    "ecr:logout": ".aws/ecr-logout",
    "ecr:getbase": ".aws/ecr-push-base-image",
    "docker:lint": "dotenv -- hadolint Dockerfile",
    "docker:build": ".docker-compose/docker-build",
    "docker:run": ".docker-compose/docker-run",
    "docker:push": ".docker-compose/docker-push",
    "openapi:bundle": "redocly bundle -o openapi/openapi.bundled.yaml && redocly build-docs -o openapi/openapi.static.html && openapi-typescript openapi/openapi.bundled.yaml --output src/types/openapi.schema.d.ts",
    "openapi:genkey": "dotenv -- ts-node openapi/apikey-tool.ts -e",
    "openapi:uiview": "open http://localhost:3002",
    "dev-app:lint": ".docker-compose/dev-app/lint",
    "dev-app:test": ".docker-compose/dev-app/test",
    "mysql:root": ".docker-compose/rdb/mysql-root",
    "lint": "prisma format && eslint 'src/**/*.ts' --fix",
    "debug": ".docker-compose/start-debug",
    "start": "echo starting via package.json is not intended; exit 1"
  },
  "watch": {
    "openapi:bundle": {
      "patterns": "openapi",
      "extensions": "yaml",
      "ignore": [
        "openapi.bundled.yaml",
        "openapi.static.html"
      ]
    }
  },
  "dependencies": {
    "@godaddy/terminus": "4.11.2",
    "@prisma/client": "4.11.0",
    "ajv": "8.12.0",
    "ajv-formats": "2.1.1",
    "compression": "1.7.4",
    "cookie-parser": "1.4.6",
    "cors": "2.8.5",
    "date-fns": "2.29.3",
    "express": "4.19.2",
    "express-list-endpoints": "6.0.0",
    "express-openapi": "12.1.0",
    "helmet": "6.0.1",
    "http-errors": "2.0.0",
    "js-yaml": "4.1.0",
    "lodash.pick": "4.4.0",
    "morgan": "1.10.0",
    "uuid": "9.0.0"
  },
  "devDependencies": {
    "@commitlint/cli": "17.4.4",
    "@commitlint/config-conventional": "17.4.4",
    "@faker-js/faker": "7.6.0",
    "@mermaid-js/mermaid-cli": "10.0.2",
    "@openapi-contrib/json-schema-to-openapi-schema": "2.2.4",
    "@redocly/cli": "1.0.0-beta.124",
    "@swc/core": "1.3.40",
    "@swc/helpers": "0.4.14",
    "@swc/jest": "0.2.24",
    "@types/compression": "1.7.2",
    "@types/cookie-parser": "1.4.3",
    "@types/cors": "2.8.5",
    "@types/eslint": "8.21.1",
    "@types/eslint-config-prettier": "~6.11.3",
    "@types/express": "4.17.17",
    "@types/express-list-endpoints": "6.0.0",
    "@types/faker": "6.6.6",
    "@types/http-errors": "2.0.0",
    "@types/jest": "29.4.0",
    "@types/jest-environment-puppeteer": "5.0.6",
    "@types/js-yaml": "4.0.5",
    "@types/lodash.pick": "4.4.0",
    "@types/morgan": "1.9.4",
    "@types/node": "16.18.14",
    "@types/prettier": "2.7.2",
    "@types/puppeteer": "5.4.7",
    "@types/regenerator-runtime": "~0.13.8",
    "@types/supertest": "2.0.12",
    "@types/uuid": "9.0.0",
    "@typescript-eslint/eslint-plugin": "5.54.0",
    "@typescript-eslint/parser": "5.54.0",
    "dotenv-cli": "7.0.0",
    "eslint": "8.35.0",
    "eslint-config-prettier": "8.6.0",
    "eslint-import-resolver-typescript": "3.5.3",
    "eslint-plugin-import": "2.27.5",
    "eslint-plugin-jest": "27.2.1",
    "eslint-plugin-unused-imports": "2.0.0",
    "getopts": "2.3.0",
    "husky": "8.0.3",
    "jest": "29.5.0",
    "jest-date-mock": "1.0.8",
    "jest-puppeteer": "8.0.6",
    "json5": "2.2.3",
    "lint-staged": "13.1.2",
    "npm-watch": "0.11.0",
    "openapi-typescript": "6.2.0",
    "prettier": "2.8.4",
    "prisma": "4.11.0",
    "prisma-docs-generator": "0.6.0",
    "prisma-erd-generator": "1.2.5",
    "prisma-factory": "0.1.13",
    "prisma-json-schema-generator": "3.1.2",
    "prisma-json-types-generator": "2.2.3",
    "puppeteer": "19.8.2",
    "regenerator-runtime": "0.13.11",
    "supertest": "6.3.3",
    "ts-jest": "29.0.5",
    "ts-node": "10.9.1",
    "tsc-watch": "6.0.0",
    "tsconfig-paths": "4.1.2",
    "typescript": "4.9.5",
    "typesync": "0.13.4",
    "yarn-run-all": "3.1.1"
  },
  "lint-staged": {
    "*.{json,yaml,md,html}": [
      "prettier --write --list-different"
    ],
    "src/**/*.{ts,tsx,js,jsx}": [
      "eslint --fix"
    ],
    "*.prisma": [
      "prisma format"
    ]
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ],
    "rules": {
      "body-leading-blank": [
        1,
        "always"
      ],
      "footer-leading-blank": [
        1,
        "always"
      ],
      "header-max-length": [
        2,
        "always",
        72
      ],
      "scope-case": [
        2,
        "always",
        "lowerCase"
      ],
      "subject-empty": [
        2,
        "never"
      ],
      "subject-case": [
        0
      ],
      "subject-full-stop": [
        2,
        "never",
        "."
      ],
      "type-case": [
        2,
        "always",
        "lowerCase"
      ],
      "type-empty": [
        2,
        "never"
      ],
      "type-enum": [
        2,
        "always",
        [
          "build",
          "chore",
          "docs",
          "feat",
          "fix",
          "refact",
          "revert",
          "style",
          "test"
        ]
      ]
    }
  }
}
